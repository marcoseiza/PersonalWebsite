---
import Post from "../../layouts/post-layout.astro";
const { slug } = Astro.params;

const post = (
  Object.values(import.meta.glob("../../posts/*.md", { eager: true })) as any[]
).find((p) => p.frontmatter.slug === slug);
---

<Post
  title={post?.frontmatter.title}
  date={post?.frontmatter.date}
  headings={post?.getHeadings() || []}
>
  {post && <post.Content />}
</Post>
